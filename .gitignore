# Secrets and local data — never commit (.env holds SECRET_KEY and the login passwords)
.env
.env.*
!.env.example
backend/.env
backend/*.db
backend/*.db-*
backend/uploads/
backend/backups/
backups/
# Customer PO samples used by tests contain personal data
backend/tests/fixtures/samples/

# Tooling
backend/.venv/
__pycache__/
.pytest_cache/
frontend/node_modules/
frontend/dist/
*.log

# SSH keys / certificates — never commit
*.pem
*.key
