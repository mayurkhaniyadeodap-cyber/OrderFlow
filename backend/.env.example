# Copy this file to .env and adjust. Never commit .env.

# REQUIRED for real use: a long random secret used to sign login tokens.
# Generate one with:  py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Login session length in minutes (default 8 hours = one shift).
TOKEN_EXPIRE_MINUTES=480

# SQLite database file, upload folder and backup folder (relative to the backend folder).
DATABASE_PATH=order_portal.db
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# Maximum upload size in megabytes (PO PDFs, logos, photos).
MAX_UPLOAD_MB=15

# Time zone used for internal order numbers (year) and the print view.
APP_TIMEZONE=Asia/Kolkata

# Prefix for internal order numbers, e.g. OF-2026-00001
ORDER_NUMBER_PREFIX=OF

# Network address the start scripts listen on:
#   127.0.0.1 = this computer only (also use this behind a reverse proxy such as IIS, Caddy or nginx)
#   0.0.0.0   = reachable from other computers on the network
HOST=127.0.0.1

# Port for the start scripts and the Vite dev proxy (change it if 8000 is already in use).
PORT=8000

# API documentation pages (/docs, /redoc, /openapi.json). Set to false on a live server.
ENABLE_API_DOCS=true

# Allowed browser origins for the API (only needed if the frontend is not served via the Vite proxy).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- Login accounts: one per panel (Admin, Sales, Printing) ----
# Fill these in your own backend\.env only. NEVER put real passwords in this example file.
# On backend start, an account is created only when NO account with that role exists yet (username and password
# both set). Existing accounts are never changed: editing a password here later does NOT change it - use
# Admin -> Users -> Reset password. Passwords are stored only as bcrypt hashes and never logged.
# Username: 3-32 characters (a-z 0-9 . _ -); sign-in ignores capitals.
# Password rule: at least 8 characters, mixing letters with numbers or symbols.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SALES_USERNAME=sales
SALES_PASSWORD=
PRINTING_USERNAME=printing
PRINTING_PASSWORD=
